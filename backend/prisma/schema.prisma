generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id             String         @id @default(uuid())
  name           String
  registrationNo String         @unique
  college        String
  points         Int            @default(0)
  active         Boolean        @default(true)
  correctAnswers Int            @default(0)
  wrongAnswers   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bids           Bid[]
  scoreLogs      ScoreLog[]
  auctionWins    AuctionRound[] @relation("Winner")
}

model Question {
  id            String         @id @default(uuid())
  text          String
  category      String
  difficulty    String         // EASY, MEDIUM, HARD, SUPER_CHALLENGE
  basePoints    Int
  answer        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auctionRounds AuctionRound[]
}

model AuctionRound {
  id             String    @id @default(uuid())
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id])
  status         String    // IDLE, BIDDING_OPEN, BIDDING_CLOSED, WINNER_CONFIRMED, ANSWER_IN_PROGRESS, COMPLETED, CANCELLED
  winnerId       String?
  winner         Team?     @relation("Winner", fields: [winnerId], references: [id])
  winningBid     Int?
  result         String?   // CORRECT, WRONG, null
  penaltyApplied Boolean   @default(false)
  roundNumber    Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bids           Bid[]
  scoreLogs      ScoreLog[]
}

model Bid {
  id         String       @id @default(uuid())
  roundId    String
  round      AuctionRound @relation(fields: [roundId], references: [id])
  teamId     String
  team       Team         @relation(fields: [teamId], references: [id])
  amount     Int
  timestamp  DateTime     @default(now())
  type       String       // CUSTOM, FAST
}

model ScoreLog {
  id             String        @id @default(uuid())
  teamId         String
  team           Team          @relation(fields: [teamId], references: [id])
  roundId        String?
  round          AuctionRound? @relation(fields: [roundId], references: [id])
  type           String        // INITIAL, PENALTY, WIN_REWARD, MANUAL_ADJUST, BID_PLACED, BID_REFUND
  pointsChanged  Int
  previousPoints Int
  newPoints      Int
  reason         String?
  timestamp      DateTime      @default(now())
}
